{
  "id": "bn-05",
  "kind": "lesson",
  "level": "A1",
  "order": 5,
  "title": "Pronouns and Address",
  "summary": "The personal pronouns, the three grades of second-person address — তুই, তুমি, আপনি — and the matching third-person polite and familiar forms, with their genitives and objectives.",
  "rules": [
    {
      "id": "three-address",
      "number": "35",
      "heading": "Three Ways to Say You",
      "statement": "Bengali has three second-person pronouns, graded by intimacy and respect: **তুই** (tui) very familiar, **তুমি** (tumi) familiar, and **আপনি** (apni) polite. Each selects its own verb ending later; the pronoun and the ending must match.",
      "examples": [
        {
          "target": "তুই",
          "roman": "tui",
          "gloss": "you — intimate, or to a child or inferior"
        },
        {
          "target": "তুমি",
          "roman": "tumi",
          "gloss": "you — familiar, friends and equals"
        },
        {
          "target": "আপনি",
          "roman": "apni",
          "gloss": "you — polite; Beames: to gentlemen and respectable people"
        }
      ],
      "paradigms": [],
      "footnotes": [
        "Beames warns that তুমি to a stranger of standing is almost an insult; আপনি is the safe public form."
      ],
      "seeAlso": [],
      "sources": [
        {
          "kind": "grammar",
          "citation": "Beames, John, *Grammar of the Bengali Language Literary and Colloquial*, Clarendon Press, Oxford, 1891.",
          "url": "https://archive.org/details/grammarofbengali00beamrich",
          "licence": "Public domain",
          "note": "Open scan on the Internet Archive."
        },
        {
