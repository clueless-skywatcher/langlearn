    {
      "id": "address-verb-preview",
      "number": "42",
      "heading": "Address Chooses the Verb Ending",
      "statement": "The five finite-verb slots of the next lesson are locked to these pronouns: আমি → **-ি**, তুই → **-িস**, তুমি → **-ো**, সে → **-ে**, আপনি / তিনি → **-েন**. Switching the pronoun without switching the ending is ungrammatical.",
      "examples": [
        {
          "target": "তুমি … -ো",
          "roman": "tumi … -o",
          "gloss": "familiar you takes the -ো ending"
        },
        {
          "target": "আপনি … -েন",
          "roman": "apni … -en",
          "gloss": "polite you takes the -েন ending"
        },
        {
          "target": "তুই … -িস",
          "roman": "tui … -is",
          "gloss": "very familiar you takes the -িস ending"
        }
      ],
      "paradigms": [],
      "footnotes": [],
      "seeAlso": [
        "three-address",
        "third-person-honor"
      ],
