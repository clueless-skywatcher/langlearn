  "rules": [
    {
      "id": "juktakshar-defined",
      "number": "22",
      "heading": "What a যুক্তাক্ষর Is",
      "statement": "When one consonant follows another with no vowel between them, Bengali writes the two as one compound letter, a যুক্তাক্ষর (juktakkhor). The first consonant sheds its inherent অ; the হসন্ত marks that loss when the letters are shown apart.",
      "examples": [
        {
          "target": "ক্ + ত → ক্ত",
          "roman": "k + t → kto",
          "gloss": "the conjunct in রক্ত"
        }
      ],
      "paradigms": [],
      "footnotes": [],
      "seeAlso": [
        "consonant-inherent",
        "inherent-o"
      ],
      "sources": [
        {
          "kind": "grammar",
          "citation": "Beames, John, *Grammar of the Bengali Language Literary and Colloquial*, Clarendon Press, Oxford, 1891.",
          "url": "https://archive.org/details/grammarofbengali00beamrich",
          "licence": "Public domain",
          "note": "Open scan on the Internet Archive."
        },
        {
          "kind": "grammar",
          "citation": "Wikipedia contributors, \"Bengali alphabet\", *Wikipedia*, retrieved 13 August 2026.",
          "url": "https://en.wikipedia.org/wiki/Bengali_alphabet",
          "licence": "CC BY-SA 4.0"
        }
      ],
      "core": true
    },
    {
      "id": "conjunct-shapes",
      "number": "23",
      "heading": "How Conjuncts Are Built",
      "statement": "A conjunct may stack its letters, join them side by side on one vertical stroke, or compress the first letter into a reduced form. Some shapes keep both letters clear; others alter them enough that the parts are hard to recognise.",
      "examples": [
        {
          "target": "ন্ন",
          "roman": "nno",
          "gloss": "ন stacked on ন"
        },
        {
          "target": "ন্দ",
          "roman": "ndo",
          "gloss": "ন beside দ"
        },
        {
          "target": "স্ক",
          "roman": "sko",
          "gloss": "স reduced above ক"
        }
      ],
      "paradigms": [],
      "footnotes": [],
      "seeAlso": [
        "juktakshar-defined"
      ],
      "sources": [
        {
          "kind": "grammar",
          "citation": "Wikipedia contributors, \"Bengali alphabet\", *Wikipedia*, retrieved 13 August 2026.",
          "url": "https://en.wikipedia.org/wiki/Bengali_alphabet",
          "licence": "CC BY-SA 4.0"
        }
      ],
      "core": true
    },
    {
      "id": "reph-rophola",
      "number": "24",
      "heading": "রেফ and র-ফলা",
      "statement": "র as the *first* member of a conjunct becomes রেফ, a mark above the following consonant, as in র্ক. র as the *second* member becomes র-ফলা, a diagonal stroke below or through the preceding letter, as in প্র and ত্র.",
      "examples": [
        {
          "target": "কর্ম",
          "roman": "kormo",
          "gloss": "work — রেফ on ম"
        },
        {
          "target": "প্রথম",
          "roman": "prothom",
          "gloss": "first — র-ফলা on প"
        }
      ],
      "paradigms": [],
      "footnotes": [
        "Beames writes the same distinction: র before another consonant takes the superscript form; র after another consonant takes the subjoined stroke."
      ],
      "seeAlso": [
        "juktakshar-defined"
      ],
      "sources": [
        {
          "kind": "grammar",
          "citation": "Beames, John, *Grammar of the Bengali Language Literary and Colloquial*, Clarendon Press, Oxford, 1891.",
          "url": "https://archive.org/details/grammarofbengali00beamrich",
          "licence": "Public domain",
          "note": "Open scan on the Internet Archive."
        },
        {
          "kind": "grammar",
          "citation": "Wikipedia contributors, \"Bengali alphabet\", *Wikipedia*, retrieved 13 August 2026.",
          "url": "https://en.wikipedia.org/wiki/Bengali_alphabet",
          "licence": "CC BY-SA 4.0"
        }
      ],
      "core": true
    },
    {
      "id": "jophola",
      "number": "25",
      "heading": "য-ফলা",
      "statement": "য as the second member of a conjunct is written য-ফলা (্য), a mark under or after the preceding consonant. It may geminate that consonant, colour the vowel, or be largely silent; it does not sound as a full য.",
      "examples": [
        {
          "target": "অন্য",
          "roman": "onno",
          "gloss": "other — য-ফলা after ন"
        },
        {
          "target": "বিদ্যা",
          "roman": "bidda",
          "gloss": "learning"
        }
      ],
      "paradigms": [],
      "footnotes": [],
      "seeAlso": [
        "juktakshar-defined",
        "dotted-letters"
      ],
      "sources": [
