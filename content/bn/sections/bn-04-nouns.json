    {
      "id": "noun-measure",
      "number": "34",
      "heading": "Measure Words",
      "statement": "A counted noun takes a measure word between the numeral and the noun. The general measure is **-টা**; humans often take **জন** (jon).",
      "examples": [
        {
          "target": "একটা বই",
          "roman": "êkṭa boi",
          "gloss": "one book"
        },
        {
          "target": "দুইজন মানুষ",
          "roman": "duijon manuś",
          "gloss": "two people"
        }
      ],
      "paradigms": [],
      "footnotes": [],
      "seeAlso": [
        "noun-definite"
      ],
