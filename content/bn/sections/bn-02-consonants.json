    {
      "id": "dotted-letters",
      "number": "18",
      "heading": "ড়, ঢ় and য়",
      "statement": "Three letters of the modern alphabet are written with a dot beneath a familiar shape: ড় and ঢ় are flapped forms of ড and ঢ, and য় is the semivowel that cannot open a word. য opens words; য় does not.",
      "examples": [
        {
          "target": "বাড়ি",
          "roman": "baṛi",
          "gloss": "house, home"
        },
        {
          "target": "পড়া",
          "roman": "pôṛa",
          "gloss": "to read; to fall"
        }
      ],
      "paradigms": [],
      "footnotes": [
        "য় was distinguished from য in the nineteenth-century reform of the script; both remain in the inventory."
      ],
      "seeAlso": [
        "final-series"
      ],
      "sources": [
        {
          "kind": "grammar",
          "citation": "Wikipedia contributors, \"Bengali alphabet\", *Wikipedia*, retrieved 13 August 2026.",
          "url": "https://en.wikipedia.org/wiki/Bengali_alphabet",
          "licence": "CC BY-SA 4.0"
        },
        {
          "kind": "dictionary",
          "citation": "English Wiktionary entries for Bengali lemmas (WT:BN TR transliteration), retrieved 13 August 2026.",
          "url": "https://en.wiktionary.org/",
          "licence": "CC BY-SA 4.0",
          "note": "Transliterations follow Wiktionary's Bengali romanization module, not a hand-built letter table (CLAUDE.md §14)."
        }
      ],
      "core": true
    },
    {
      "id": "three-sibilants",
      "number": "19",
      "heading": "The Three Sibilants",
      "statement": "শ, ষ and স keep three Sanskrit spellings. In modern Bengali they are usually one sound, /ʃ/ (or /ɕ/), with /s/ appearing in some words and clusters. Spelling, not sound, decides which letter a word takes.",
      "examples": [
        {
          "target": "শান্ত",
          "roman": "śanto",
          "gloss": "calm"
        },
        {
          "target": "আকাশ",
          "roman": "akaś",
          "gloss": "sky"
        }
      ],
      "paradigms": [],
      "footnotes": [],
