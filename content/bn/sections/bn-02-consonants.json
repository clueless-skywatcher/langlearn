    {
      "id": "consonant-inherent",
      "number": "21",
      "heading": "Inherent অ on a Consonant",
      "statement": "A bare consonant letter carries inherent অ. The হসন্ত (্) removes it, as already in ¶4; without that mark, or a কার, the letter is read with its inherent vowel.",
      "examples": [
        {
          "target": "ক",
          "roman": "kô",
          "gloss": "the letter ka, with inherent অ"
        },
        {
          "target": "ক্",
          "roman": "k",
          "gloss": "the same letter with হসন্ত, no vowel"
        }
      ],
