    {
      "id": "vowel-harmony",
      "number": "46",
      "heading": "Stem Vowel Harmony",
      "statement": "Some stems raise their vowel before high endings: লেখ- yields লিখি in the first person, while তুমি লেখো keeps the mid vowel. The verbal noun shows the unraised vowel.",
      "examples": [
        {
          "target": "আমি লিখি",
          "roman": "ami likhi",
          "gloss": "I write"
        },
        {
          "target": "তুমি লেখো",
          "roman": "tumi lekho",
          "gloss": "you write"
        },
        {
          "target": "সে লেখে",
          "roman": "se lekhe",
          "gloss": "he/she writes"
        }
      ],
      "paradigms": [],
      "footnotes": [
        "Wikipedia lists the usual raisings: ô→o, o→u, æ→e, e→i."
      ],
      "seeAlso": [
        "simple-present",
        "verb-person-honor"
      ],
      "sources": [
        {
          "kind": "grammar",
          "citation": "Wikipedia contributors, \"Bengali grammar\", *Wikipedia*, retrieved 13 August 2026.",
          "url": "https://en.wikipedia.org/wiki/Bengali_grammar",
          "licence": "CC BY-SA 4.0"
        }
      ],
      "core": true
    },
    {
      "id": "existential-ach-",
      "number": "47",
      "heading": "আছে — Existence and Location",
      "statement": "Ordinary predication in the simple present uses no copula. Existence, location and possession use the defective verb আছ-: আছে, আছো, আছি. Possession puts the possessor in the genitive: আমার একটি বই আছে.",
      "examples": [
        {
          "target": "ঘরে বই আছে",
          "roman": "ghore boi āche",
          "gloss": "there is a book in the room"
        },
        {
          "target": "আমার বই আছে",
          "roman": "amar boi āche",
          "gloss": "I have a book"
        },
        {
          "target": "আপনার কলম আছে",
          "roman": "apnar kolom āche",
          "gloss": "you (polite) have a pen"
        }
      ],
      "paradigms": [],
      "footnotes": [],
      "seeAlso": [
        "noun-genitive",
        "pronoun-genitive",
        "simple-present"
      ],
      "sources": [
        {
          "kind": "grammar",
          "citation": "Wikipedia contributors, \"Bengali grammar\", *Wikipedia*, retrieved 13 August 2026.",
          "url": "https://en.wikipedia.org/wiki/Bengali_grammar",
