    {
      "id": "simple-present",
      "number": "45",
      "heading": "The Simple Present",
      "statement": "The simple-present endings are **-ি**, **-িস**, **-ো**, **-ে**, **-েন**, each tied to one address or person grade (¶42, ¶44). They attach to the stem: করি, করিস, করো, করে, করেন.",
      "examples": [],
      "paradigms": [
        {
          "caption": "করা in the simple present, by address",
          "columns": [
            "pronoun",
            "ending",
            "form"
          ],
          "rows": [
            {
              "label": "1st",
              "cells": [
                "আমি / আমরা",
                "-ি",
                "করি"
              ]
            },
            {
              "label": "2nd VF",
              "cells": [
                "তুই / তোরা",
                "-িস",
                "করিস"
              ]
            },
            {
              "label": "2nd familiar",
              "cells": [
                "তুমি / তোমরা",
                "-ো",
                "করো"
              ]
            },
            {
              "label": "3rd familiar",
              "cells": [
                "সে / তারা",
                "-ে",
                "করে"
              ]
            },
            {
              "label": "polite",
              "cells": [
