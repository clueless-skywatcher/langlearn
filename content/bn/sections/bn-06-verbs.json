{
  "id": "bn-06",
  "kind": "lesson",
  "level": "A1",
  "order": 7,
  "title": "Verbs — Present and Negation",
  "summary": "The verbal noun, simple-present endings locked to the three address grades and the third-person forms, vowel harmony, existential আছে, negation with না, and SOV order.",
  "rules": [
    {
      "id": "verbal-noun",
      "number": "43",
      "heading": "The Verbal Noun",
      "statement": "Dictionaries list Bengali verbs in the verbal-noun form, usually stem + **-া**. করা (kora) is the verb 'to do' from the stem কর; লেখা is 'to write' from লেখ.",
      "examples": [
        {
          "target": "করা",
          "roman": "kora",
          "gloss": "to do"
        },
        {
          "target": "লেখা",
          "roman": "lekha",
          "gloss": "to write"
        },
        {
          "target": "যাওয়া",
          "roman": "jaowa",
          "gloss": "to go"
        }
      ],
      "paradigms": [],
      "footnotes": [],
      "seeAlso": [],
      "sources": [
        {
          "kind": "grammar",
          "citation": "Wikipedia contributors, \"Bengali grammar\", *Wikipedia*, retrieved 13 August 2026.",
          "url": "https://en.wikipedia.org/wiki/Bengali_grammar",
          "licence": "CC BY-SA 4.0"
        },
        {
          "kind": "dictionary",
          "citation": "English Wiktionary entries for Bengali lemmas (WT:BN TR transliteration), retrieved 13 August 2026.",
          "url": "https://en.wiktionary.org/",
