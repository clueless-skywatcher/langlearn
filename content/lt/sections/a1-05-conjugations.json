    {
      "id": "conjugation-summary",
      "number": "38",
      "heading": "The Three Conjugations Compared",
      "statement": "Set side by side, the three differ only in the vowel that runs through them — **a**, **i**, **o**. The plural endings are built alike in all three: the third-person form plus *-me* and *-te*. Learn the third person and the rest follows.",
      "paradigms": [
        {
          "caption": "The present tense in full",
          "columns": [
            "I (dirbti)",
            "II (turėti)",
            "III (skaityti)"
          ],
