{
  "id": "a1-14",
  "kind": "lesson",
  "level": "A1",
  "order": 17,
  "title": "The Future",
  "summary": "The simplest tense in the language: one marker, **-s-**, inserted between the stem and the ending, and one set of endings for every verb there is. The only difficulty is what happens when the stem already ends in a consonant that will not stand beside an s.",
  "rules": [
    {
      "id": "future-formation",
      "number": "94",
      "heading": "The Future Formed with -s-",
      "statement": "The future is built from the **infinitive** stem — the infinitive less its *-ti* — with **-s-** and the endings below. There is no division into conjugations here and no second stem to learn: whatever a verb does in the present and the past, its future is regular.",
      "paradigms": [
        {
          "caption": "dirbti → the future",
          "columns": [
            "person",
            "singular",
            "plural"
          ],
          "rows": [
            {
              "label": "1",
              "cells": [
                "dirbsiu",
                "dirbsime"
              ]
            },
            {
              "label": "2",
              "cells": [
                "dirbsi",
                "dirbsite"
              ]
            },
            {
              "label": "3",
              "cells": [
                "dirbs",
                "dirbs"
              ]
            }
          ],
          "footnote": "The third person is the bare stem with *-s* and nothing after it, and it serves both numbers as in the other tenses (¶57)."
        }
      ],
      "examples": [
        {
          "target": "Rytoj skaitysiu knygą.",
          "gloss": "Tomorrow I shall read a book."
        },
        {
          "target": "Mes važiuosime į Vilnių.",
          "gloss": "We shall go to Vilnius."
        },
        {
          "target": "Ką tu darysi?",
          "gloss": "What will you do?"
        }
      ],
      "seeAlso": [
        "present-stem",
        "past-stem",
        "verb-number"
      ],
      "core": true
    },
    {
      "id": "future-consonant-changes",
      "number": "95",
      "heading": "Consonant Changes before the -s-",
      "statement": "Where the infinitive stem already ends in **s, z, š, ž**, the marker cannot be heard beside it and the two merge into one consonant. Where it ends in **d** or **t**, that consonant becomes **s**. The endings are untouched; only the joint is affected, and the change is one of pronunciation written down rather than a grammatical irregularity.",
      "paradigms": [
        {
          "caption": "Stems that alter",
          "columns": [
            "infinitive",
            "stem",
            "future 1 sg.",
            "future 3"
          ],
          "rows": [
            {
              "label": "d → s",
              "cells": [
                "vesti",
                "ved-",
                "vesiu",
                "ves"
              ]
            },
            {
              "label": "t → s",
              "cells": [
                "mesti",
                "met-",
                "mesiu",
                "mes"
              ]
            },
            {
              "label": "š + s → š",
              "cells": [
                "nešti",
                "neš-",
                "nešiu",
                "neš"
              ]
            },
            {
              "label": "ž + s → š",
              "cells": [
                "grįžti",
                "grįž-",
                "grįšiu",
                "grįš"
              ]
            },
            {
              "label": "no change",
              "cells": [
                "dirbti",
                "dirb-",
                "dirbsiu",
                "dirbs"
              ]
            }
          ],
          "footnote": "Verbs whose stem ends in a vowel — *skaity-*, *kalbė-*, *važiuo-* — never alter: *skaitysiu*, *kalbėsiu*, *važiuosiu*."
        }
      ],
      "examples": [
        {
          "target": "Rytoj grįšiu namo.",
          "gloss": "Tomorrow I shall return home.",
          "note": "*grįž-* + *-s-* gives *grįš-*"
        },
        {
          "target": "Jis neš knygas.",
          "gloss": "He will carry the books."
        }
      ],
      "seeAlso": [
        "future-formation",
        "spelling-phonemic"
      ],
      "core": true
    },
    {
      "id": "future-buti",
      "number": "96",
      "heading": "The Future of Būti",
      "statement": "**Būti** follows the rule exactly, and its third person **bus** is among the most useful words in the language: it does duty for *there will be*, *it will be*, and *they will be* together, and it is what a Lithuanian says when asked whether something is going to happen.",
      "paradigms": [
        {
          "caption": "būti → the future",
          "columns": [
            "person",
            "singular",
            "plural"
          ],
          "rows": [
            {
              "label": "1",
              "cells": [
                "būsiu",
                "būsime"
              ]
            },
            {
              "label": "2",
              "cells": [
                "būsi",
                "būsite"
              ]
            },
            {
              "label": "3",
              "cells": [
                "bus",
                "bus"
              ]
            }
          ]
        }
      ],
      "examples": [
        {
          "target": "Rytoj būsiu namie.",
          "gloss": "Tomorrow I shall be at home."
        },
        {
          "target": "Ar bus kavos?",
          "gloss": "Will there be coffee?",
          "note": "genitive after an existential question, as with *yra* and *nėra*"
        },
        {
          "target": "Bus gerai.",
          "gloss": "It will be all right."
        }
      ],
      "seeAlso": [
        "future-formation",
        "buti-present",
        "past-buti"
      ],
      "core": true
    },
    {
      "id": "future-negation",
      "number": "97",
      "heading": "Negation in the Future",
      "statement": "As in the other tenses, **ne-** is written onto the front of the verb and the object of the negated verb passes into the **genitive**. Nothing new is needed; what is needed is the habit, since a learner who has mastered the genitive of negation in the present often loses it the moment the tense changes.",
      "examples": [
        {
          "target": "Rytoj nedirbsiu.",
          "gloss": "Tomorrow I shall not work."
        },
        {
          "target": "Aš nepirksiu šios knygos.",
          "gloss": "I shall not buy this book.",
          "note": "genitive *knygos*, not accusative *knygą*"
        },
        {
          "target": "Jų nebus.",
          "gloss": "They will not be there."
        }
      ],
      "seeAlso": [
        "negation",
        "negation-genitive",
        "past-negation"
      ],
      "core": true
    },
    {
      "id": "future-uses",
      "number": "98",
      "heading": "Saying What Will Happen",
      "statement": "The future serves for intention, for promise and for prediction alike; Lithuanian has no separate *going to*. Its usual markers are **rytoj** (tomorrow), **kitą savaitę** (next week) and **po** with the genitive (¶33). Note that where English uses a present tense after *when* and *if* in speaking of the future, Lithuanian uses the **future** there too, and says what it means.",
      "paradigms": [
        {
          "caption": "Where English changes tense and Lithuanian does not",
          "columns": [
            "Lithuanian",
            "English",
            "note"
          ],
          "rows": [
            {
              "label": "plain",
              "cells": [
                "Rytoj dirbsiu.",
                "Tomorrow I shall work.",
                "prediction"
              ]
            },
            {
              "label": "promise",
              "cells": [
                "Padarysiu.",
                "I'll do it.",
                "no pronoun needed"
              ]
            },
            {
              "label": "after when",
              "cells": [
                "Kai grįšiu, skambinsiu.",
                "When I get back, I'll ring.",
                "future in both halves"
              ]
            }
          ]
        }
      ],
      "examples": [
        {
          "target": "Kitą savaitę važiuosime prie jūros.",
          "gloss": "Next week we shall go to the seaside."
        },
        {
          "target": "Po mėnesio jis bus Lietuvoje.",
          "gloss": "In a month he will be in Lithuania."
        }
      ],
      "seeAlso": [
        "future-formation",
        "time-prepositions",
        "accusative-of-time"
      ],
      "core": true
    }
  ],
