                "them"
              ]
            }
          ]
        }
      ],
      "examples": [
        {
          "target": "Jis mane mato.",
          "gloss": "He sees me."
        },
        {
          "target": "Aš tave myliu.",
          "gloss": "I love you."
        }
      ],
      "seeAlso": [
        "pronouns-nom",
        "accusative-nouns"
      ],
      "core": true
    },
    {
      "id": "conjugations",
      "number": "23",
      "heading": "The Three Conjugations",
      "statement": "Lithuanian verbs fall into **three conjugations**, distinguished by the ending of the **third person present**: **-a** (first), **-i** (second), **-o** (third). Since this form cannot be predicted from the infinitive, dictionaries cite every verb by three **principal parts** — infinitive, third person present, third person past — and this course does likewise. Learn the three parts together; from them every other form can be built.",
      "paradigms": [
        {
          "caption": "The three conjugations, third person present",
          "columns": [
            "infinitive",
            "3rd pres.",
            "3rd past",
            "conjugation"
          ],
          "rows": [
            {
              "label": "to work",
              "cells": [
                "dirbti",
                "dirba",
                "dirbo",
                "first"
              ]
            },
            {
              "label": "to have",
              "cells": [
                "turėti",
                "turi",
                "turėjo",
                "second"
              ]
            },
            {
              "label": "to read",
              "cells": [
                "skaityti",
                "skaito",
                "skaitė",
                "third"
              ]
            }
          ],
          "footnote": "The infinitive ending -ti is common to all three and says nothing about the conjugation."
        }
      ],
      "examples": [
        {
          "target": "dirbti, dirba, dirbo",
          "gloss": "to work",
          "note": "the form in which a verb is memorised"
        }
      ],
      "seeAlso": [
        "buti-present"
      ],
      "core": true
    },
    {
      "id": "present-conj-i",
      "number": "24",
      "heading": "The Present Tense of the First Conjugation",
      "statement": "The personal endings are added to the present stem, which is got by removing the **-a** of the third person present. As with *būti* (¶15), **one form serves the whole third person**, singular and plural, masculine and feminine alike. Because the ending already names the person, the subject pronoun is usually left out.",
      "paradigms": [
        {
          "caption": "dirbti (dirba) — present tense",
          "columns": [
            "ending",
            "form",
            "English"
          ],
          "rows": [
            {
              "label": "aš",
              "cells": [
                "-u",
                "dirbu",
                "I work"
              ]
            },
            {
              "label": "tu",
              "cells": [
                "-i",
                "dirbi",
                "you work"
              ]
            },
            {
              "label": "jis, ji",
              "cells": [
                "-a",
                "dirba",
                "he, she works"
              ]
            },
            {
              "label": "mes",
              "cells": [
                "-ame",
                "dirbame",
                "we work"
              ]
            },
            {
              "label": "jūs",
              "cells": [
                "-ate",
                "dirbate",
                "you work"
              ]
            },
            {
              "label": "jie, jos",
              "cells": [
                "-a",
                "dirba",
                "they work"
              ]
            }
          ]
        }
      ],
      "examples": [
        {
          "target": "Aš dirbu.",
          "gloss": "I work, I am working.",
          "note": "Lithuanian has one present tense where English has two"
        },
        {
          "target": "Kalbame lietuviškai.",
          "gloss": "We speak Lithuanian.",
          "note": "pronoun omitted"
        }
      ],
      "footnotes": [
        "The present tense renders both the English simple present and the present progressive. *Jis rašo laišką* is equally \"he writes a letter\" and \"he is writing a letter\"."
      ],
      "seeAlso": [
        "conjugations",
        "pronouns-nom"
      ],
      "core": true
    },
    {
      "id": "negation",
      "number": "25",
      "heading": "Negation of the Verb",
      "statement": "A verb is negated by prefixing **ne-** and writing it as one word with the verb. The prefix draws the stress to itself in many words, but the spelling never separates it. The same *ne* standing alone is the word for \"no\".",
      "examples": [
        {
          "target": "Aš nedirbu.",
          "gloss": "I do not work."
        },
        {
          "target": "Jis neskaito.",
          "gloss": "He does not read."
        },
        {
          "target": "Ne, ačiū.",
          "gloss": "No, thank you.",
          "note": "ne standing alone"
        }
      ],
      "footnotes": [
        "būti is irregular here: the third person negative is nėra, not *neyra (see ¶15)."
      ],
      "seeAlso": [
        "buti-present"
      ],
      "core": true
    },
    {
      "id": "negation-genitive",
      "number": "26",
      "heading": "The Object of a Negated Verb",
      "statement": "When a transitive verb is negated, its direct object leaves the accusative and takes the **genitive** instead. The reason is that a negated verb asserts that no part of the thing was affected, and the genitive is the case of the part rather than the whole. The genitive is treated fully in the next section; for the present, **recognise** the change and do not be surprised by it.",
      "examples": [
        {
          "target": "Aš matau namą.",
          "gloss": "I see a house.",
          "note": "accusative"
        },
        {
          "target": "Aš nematau namo.",
          "gloss": "I do not see a house.",
          "note": "genitive"
        },
        {
          "target": "Ji turi knygą. → Ji neturi knygos.",
          "gloss": "She has a book. → She has no book."
        }
      ],
      "seeAlso": [
        "negation",
        "accusative-nouns"
      ],
      "core": true
    },
    {
      "id": "conjunction-ir",
      "number": "27",
      "heading": "The Conjunction Ir",
      "statement": "**Ir** joins words or clauses of like kind, as English *and*. Joined objects each stand in the accusative, the case being repeated and not merely understood.",
      "examples": [
        {
          "target": "Ji valgo obuolį ir geria arbatą.",
          "gloss": "She eats an apple and drinks tea."
        },
        {
          "target": "Aš matau namą ir katę.",
          "gloss": "I see a house and a cat."
        }
      ],
      "seeAlso": [
        "accusative-nouns"
      ],
      "core": false
    }
  ],
