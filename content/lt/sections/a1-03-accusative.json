{
  "id": "a1-03",
  "kind": "lesson",
  "level": "A1",
  "order": 3,
  "title": "The Accusative, Transitive Verbs, and Negation",
  "summary": "Transitive verbs take a direct object in the accusative; nouns, adjectives and pronouns all mark that case. The present tense of the first conjugation is given, and the rule that negation drives the object into the genitive is stated for recognition.",
  "rules": [
    {
      "id": "transitive-objects",
      "number": "19",
      "heading": "Transitive Verbs and the Direct Object",
      "statement": "A **transitive verb** expresses an action that passes over from the subject to some other person or thing — one *sees* a house, *reads* a book. That other person or thing is the **direct object**, and in Lithuanian it is put into the **accusative case**. An intransitive verb, expressing an action confined to the subject, takes no object: *Berniukas dirba*, the boy works.",
      "examples": [
        {
          "target": "Berniukas skaito knygą.",
          "gloss": "The boy reads a book.",
          "note": "knygą, accusative, the thing read"
        },
        {
          "target": "Berniukas dirba.",
          "gloss": "The boy works.",
          "note": "intransitive; nothing is worked"
        }
      ],
      "seeAlso": [
        "nominative"
      ],
      "core": true
    },
    {
      "id": "accusative-nouns",
      "number": "20",
      "heading": "The Accusative Singular of Nouns",
      "statement": "The accusative singular is formed by **shortening the ending to its bare vowel and adding the nosinė hook**. Each nominative ending has one accusative counterpart, and the correspondence admits no exceptions in the singular. Observe that masculine **-is** and **-ys** fall together in **-į**, so that the accusative alone will not tell you which the noun was.",
      "paradigms": [
        {
          "caption": "Nominative → accusative singular",
          "columns": [
            "nominative",
            "accusative",
            "example"
          ],
          "rows": [
            {
              "label": "masc. -as",
              "cells": [
                "-as",
                "-ą",
                "namas → namą"
              ]
            },
            {
              "label": "masc. -is",
              "cells": [
                "-is",
                "-į",
                "brolis → brolį"
              ]
            },
            {
              "label": "masc. -ys",
              "cells": [
                "-ys",
                "-į",
                "obuolys → obuolį"
              ]
            },
            {
              "label": "masc. -us",
              "cells": [
                "-us",
                "-ų",
                "sūnus → sūnų"
              ]
            },
            {
              "label": "fem. -a",
              "cells": [
                "-a",
                "-ą",
                "knyga → knygą"
              ]
            },
            {
              "label": "fem. -ė",
              "cells": [
                "-ė",
                "-ę",
                "katė → katę"
              ]
            }
          ],
          "footnote": "Every accusative singular ending is a nosinė vowel. This is the grammatical work the hook does, and the reason it may never be omitted (see ¶3)."
        }
      ],
      "examples": [
        {
          "target": "Aš matau namą.",
          "gloss": "I see a house."
        },
        {
          "target": "Ji myli brolį.",
          "gloss": "She loves her brother."
        },
        {
          "target": "Mes turime katę.",
          "gloss": "We have a cat."
        }
      ],
      "seeAlso": [
        "nosine",
        "noun-endings",
        "transitive-objects"
      ],
      "core": true
    },
    {
      "id": "accusative-adjectives",
      "number": "21",
      "heading": "The Accusative of Adjectives",
      "statement": "An adjective modifying a noun in the accusative is itself put into the accusative, agreeing as always in gender (¶17). The class in **-us / -i** is the only one that needs care: the feminine *graži* makes *gražią*, with an -i- that is not present in the masculine *gražų*.",
      "paradigms": [
        {
          "caption": "Adjective, nominative → accusative singular",
          "columns": [
            "masculine",
            "feminine"
          ],
          "rows": [
            {
              "label": "class I",
              "cells": [
                "geras → gerą",
                "gera → gerą"
              ]
            },
            {
              "label": "class II",
              "cells": [
                "gražus → gražų",
                "graži → gražią"
              ]
            },
            {
              "label": "class III",
              "cells": [
                "didelis → didelį",
                "didelė → didelę"
              ]
            }
          ]
        }
      ],
      "examples": [
        {
          "target": "Aš matau didelį namą.",
          "gloss": "I see a big house."
        },
        {
          "target": "Ji skaito naują knygą.",
          "gloss": "She is reading a new book."
        },
        {
          "target": "Mes turime gražią katę.",
          "gloss": "We have a beautiful cat."
        }
      ],
      "seeAlso": [
        "adjective-agreement",
        "accusative-nouns"
      ],
      "core": true
    },
    {
      "id": "accusative-pronouns",
      "number": "22",
      "heading": "The Accusative of the Personal Pronouns",
      "statement": "The personal pronouns have their own accusative forms, which must be learned as a list. Unlike the nouns, they do not end in a nosinė vowel.",
      "paradigms": [
        {
          "caption": "Personal pronouns, nominative and accusative",
          "columns": [
            "nominative",
            "accusative",
            "English"
          ],
          "rows": [
            {
              "label": "1 sg.",
              "cells": [
                "aš",
                "mane",
                "me"
              ]
            },
            {
              "label": "2 sg.",
              "cells": [
                "tu",
                "tave",
                "you"
              ]
            },
            {
              "label": "3 sg. m.",
              "cells": [
                "jis",
                "jį",
                "him, it"
              ]
            },
            {
              "label": "3 sg. f.",
              "cells": [
                "ji",
                "ją",
                "her, it"
              ]
            },
            {
              "label": "1 pl.",
              "cells": [
                "mes",
                "mus",
                "us"
              ]
            },
            {
              "label": "2 pl.",
              "cells": [
                "jūs",
                "jus",
                "you"
              ]
            },
            {
              "label": "3 pl. m.",
              "cells": [
                "jie",
