      "type": "single",
      "difficulty": "easy",
      "stem": "What is the accusative singular of **knyga**?",
      "options": [
        "knygos",
        "knygą",
        "knygę",
        "knyga"
      ],
      "correct": 1,
      "explanation": "Feminine -a → -ą (¶20). *knygos* is genitive (negation trap); *knygę* wrongly uses the -ė → -ę pattern; *knyga* is still nominative.",
      "rulesTested": [
        "accusative-nouns"
      ],
      "vocabUsed": [
        "knyga"
      ]
    },
