{
  "id": "a1-10",
  "kind": "lesson",
  "level": "A1",
  "order": 12,
  "title": "The Dative",
  "summary": "The case of the person concerned: the indirect object, and the constructions in which Lithuanian says that a thing pleases to somebody or is necessary to somebody, where English would make that somebody the subject.",
  "rules": [
    {
      "id": "dative-endings",
      "number": "65",
      "heading": "The Dative Singular",
      "statement": "The **dative** answers *kam?* (to whom? for whom?) and names the person on whose behalf or towards whom the action is done. Its endings are given below; note that the masculine **-ui** and the feminine **-ai** are the marks of the case, and that the feminine dative *-ai* is not the masculine nominative plural *-ai* of ¶53.",
      "paradigms": [
        {
          "caption": "Nominative → dative singular",
          "columns": [
            "nominative",
            "dative",
            "example"
          ],
          "rows": [
            {
              "label": "masc. -as",
              "cells": [
                "-as",
                "-ui",
                "brolis → broliui, namas → namui"
              ]
            },
            {
              "label": "masc. -is",
              "cells": [
                "-is",
                "-iui",
                "brolis → broliui"
              ]
            },
            {
              "label": "masc. -us",
              "cells": [
                "-us",
                "-ui",
                "sūnus → sūnui"
              ]
            },
            {
              "label": "fem. -a",
              "cells": [
                "-a",
                "-ai",
                "mama → mamai"
              ]
            },
            {
              "label": "fem. -ė",
              "cells": [
                "-ė",
                "-ei",
                "katė → katei"
              ]
            }
          ],
          "footnote": "The dative plural ends in -ams, -iams, -oms, -ėms: broliams, mamoms, katėms."
        }
      ],
      "examples": [
        {
          "target": "Rašau broliui.",
          "gloss": "I am writing to my brother."
        },
        {
          "target": "Duodu knygą mamai.",
          "gloss": "I am giving the book to my mother."
        }
      ],
      "seeAlso": [
        "noun-endings",
        "locative-singular"
      ],
      "core": true
    },
    {
      "id": "indirect-object",
      "number": "66",
      "heading": "The Indirect Object",
      "statement": "A verb of giving, sending, saying or showing may have **two** objects: the thing, in the accusative, and the person, in the dative. English marks the person with *to* or by word order; Lithuanian marks it with the ending, and the order of the two is therefore free.",
      "examples": [
        {
          "target": "Aš duodu knygą broliui.",
          "gloss": "I give the book to my brother."
        },
        {
          "target": "Aš duodu broliui knygą.",
          "gloss": "I give my brother the book.",
          "note": "the same sentence; the endings settle which is which"
        },
        {
          "target": "Mokytoja rašo laišką tėvui.",
          "gloss": "The teacher writes a letter to the father."
        }
      ],
      "seeAlso": [
        "dative-endings",
        "transitive-objects"
      ],
      "core": true
    },
    {
      "id": "dative-pronouns",
      "number": "67",
      "heading": "The Dative of the Pronouns",
      "statement": "The personal pronouns have their own dative forms, and they are short and very common — they must be known cold, because the constructions of ¶68 and ¶69 are built on them.",
