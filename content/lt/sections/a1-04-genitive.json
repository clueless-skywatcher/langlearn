  "drills": [
    {
      "id": "a104-q1",
      "type": "single",
      "difficulty": "easy",
      "stem": "What is the genitive singular of **brolis**?",
      "options": [
        "brolį",
        "brolio",
        "brolyje",
        "broliui"
      ],
      "correct": 1,
      "explanation": "Masculine -is → -io (¶28). *brolį* is accusative (nosinė trap); *brolyje*/*broliui* are later cases.",
      "rulesTested": [
        "genitive-endings"
      ],
      "vocabUsed": [
        "brolis"
      ]
    },
    {
      "id": "a104-q2",
      "type": "single",
      "difficulty": "easy",
      "stem": "Translate: **the teacher's house** (male teacher).",
