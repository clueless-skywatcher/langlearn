    {
      "id": "paradigm-homographs",
      "number": "152",
      "heading": "Forms That Coincide",
      "statement": "Several slots share a spelling. The sentence must choose, and it always can, because two readings never do the same grammatical work. The coincidences worth knowing by heart are listed below; they are not exceptions but regular overlaps.",
      "paradigms": [
        {
          "caption": "Common homographs",
          "columns": [
            "form",
            "can be",
            "and also"
          ],
          "rows": [
            {
              "label": "knyga",
              "cells": [
                "nom. sg.",
                "instr. / voc. sg."
              ]
            },
            {
              "label": "knygos",
              "cells": [
                "gen. sg.",
                "nom. / voc. pl."
              ]
            },
            {
              "label": "akis",
              "cells": [
                "nom. sg.",
                "acc. pl."
              ]
            },
            {
              "label": "sūnus",
              "cells": [
                "nom. sg.",
                "acc. pl."
              ]
            },
            {
              "label": "moteris",
              "cells": [
                "nom. sg.",
                "acc. pl."
              ]
            }
          ]
        }
      ],
      "examples": [
        {
          "target": "Knyga yra nauja. / Rašau knyga.",
          "gloss": "The book is new. / I write with a book (as means — rare, but grammatical)."
        },
        {
          "target": "Matau akis. / Akis skauda.",
          "gloss": "I see eyes. / An eye hurts.",
          "note": "acc. pl. against nom. sg."
        }
      ],
      "seeAlso": [
