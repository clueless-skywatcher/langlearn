      "footnotes": []
    },
    {
      "id": "fourth-declension-paradigm",
      "number": "150",
      "heading": "The Fourth Declension: -us",
      "statement": "Masculines in **-us** are few but frequent (*sūnus, medus, žmogus* — the last irregular in the plural). The genitive is **-aus**, the instrumental the long **-umi**, the nominative plural the long **-ūs**. Do not confuse *sūnus* the nominative singular with *sūnus* the accusative plural: they are spelled alike.",
      "paradigms": [
        {
          "caption": "sūnus",
          "columns": [
            "case",
            "singular",
            "plural"
          ],
          "rows": [
            {
              "label": "nom.",
              "cells": [
                "sūnus",
                "sūnūs"
              ]
            },
            {
              "label": "gen.",
              "cells": [
                "sūnaus",
                "sūnų"
              ]
            },
            {
              "label": "dat.",
              "cells": [
                "sūnui",
                "sūnums"
              ]
            },
            {
              "label": "acc.",
              "cells": [
                "sūnų",
                "sūnus"
              ]
            },
            {
              "label": "instr.",
              "cells": [
                "sūnumi",
                "sūnumis"
              ]
            },
            {
              "label": "loc.",
              "cells": [
                "sūnuje",
                "sūnuose"
              ]
            },
            {
              "label": "voc.",
              "cells": [
                "sūnau",
                "sūnūs"
              ]
            }
          ],
          "footnote": "*žmogus* follows IV in the singular (*žmogaus, žmogui, žmogų, žmogumi, žmoguje, žmogau*) but takes an irregular plural *žmonės, žmonių, žmonėms…*."
        }
      ],
      "examples": [
        {
          "target": "Kalbu su sūnumi.",
          "gloss": "I am talking with my son."
        },
        {
          "target": "Duodu medaus.",
          "gloss": "I am giving some honey.",
          "note": "partitive genitive"
        },
        {
          "target": "Sūnau, ateik čia!",
          "gloss": "Son, come here!"
        }
      ],
      "seeAlso": [
