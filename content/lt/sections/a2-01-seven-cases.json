    {
      "id": "seven-cases-uses",
      "number": "153",
      "heading": "What Each Case Is For",
      "statement": "With the paradigms complete, the uses already taught can be stated as one map. The **nominative** names the subject and the predicate noun; the **genitive** shows possession, quantity, origin, and follows most prepositions and negation; the **dative** is the indirect object and the experiencer; the **accusative** is the direct object and the goal of motion; the **instrumental** is means, company (with *su*), and recurring time; the **locative** is place *in/at/on* without a preposition; the **vocative** only addresses.",
      "paradigms": [
        {
          "caption": "The seven cases at a glance",
          "columns": [
            "case",
            "asks",
            "chief work"
          ],
          "rows": [
            {
              "label": "nominative",
              "cells": [
                "kas?",
                "subject; predicate noun"
              ]
            },
            {
              "label": "genitive",
              "cells": [
                "ko?",
                "possession, partitive, after ne-, most prepositions"
              ]
            },
            {
              "label": "dative",
              "cells": [
                "kam?",
                "indirect object; experiencer (patinka, reikia)"
              ]
            },
            {
              "label": "accusative",
              "cells": [
                "ką?",
                "direct object; direction with į, pas; time when"
              ]
            },
            {
              "label": "instrumental",
              "cells": [
                "kuo?",
                "means; su + company; recurring time"
              ]
            },
            {
              "label": "locative",
              "cells": [
                "kur?",
                "place in/at, no preposition"
              ]
            },
            {
              "label": "vocative",
              "cells": [
                "—",
                "address only"
              ]
            }
          ]
        }
      ],
      "examples": [
        {
          "target": "Brolis duoda seseriai knygą.",
          "gloss": "The brother gives the sister a book.",
          "note": "nom. — dat. — acc."
        },
        {
          "target": "Rašau pieštuku name.",
          "gloss": "I write with a pencil in the house.",
          "note": "instr. — loc."
        }
      ],
      "seeAlso": [
        "nominative",
        "genitive-possession",
        "indirect-object",
        "transitive-objects",
        "instrumental-means",
        "locative-singular",
        "vocative"
      ],
      "core": true,
      "footnotes": []
    }
  ],
