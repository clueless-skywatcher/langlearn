    {
      "id": "third-declension-paradigm",
      "number": "149",
      "heading": "The Third Declension: -is",
      "statement": "Nouns in **-is** with genitive **-ies** (or the short **-ers** of *moteris*) are a class of their own. Most are feminine (*akis, naktis, ausis*); a few are masculine (*dantis, debesis*). The nominative plural is **-ys**, the accusative plural repeats the nominative singular (**akis**), and the instrumental singular takes the long **-imi**.",
      "paradigms": [
        {
          "caption": "akis (f.), dantis (m.)",
          "columns": [
            "case",
            "akis sg.",
            "akis pl.",
            "dantis sg.",
            "dantis pl."
          ],
          "rows": [
            {
              "label": "nom.",
              "cells": [
                "akis",
                "akys",
                "dantis",
                "dantys"
              ]
            },
            {
              "label": "gen.",
              "cells": [
                "akies",
                "akių",
                "danties",
                "dantų"
              ]
            },
            {
              "label": "dat.",
              "cells": [
                "akiai",
                "akims",
                "dančiui",
                "dantims"
              ]
            },
            {
              "label": "acc.",
              "cells": [
                "akį",
                "akis",
                "dantį",
                "dantis"
              ]
            },
            {
              "label": "instr.",
              "cells": [
                "akimi",
                "akimis",
                "dantimi",
                "dantimis"
              ]
            },
            {
              "label": "loc.",
              "cells": [
                "akyje",
                "akyse",
                "dantyje",
                "dantyse"
              ]
            },
            {
              "label": "voc.",
              "cells": [
                "akie",
                "akys",
                "dantie",
                "dantys"
              ]
            }
          ],
          "footnote": "*moteris* shortens the genitive: *moters*, not *moteries*. The dative singular of *dantis* softens: *dančiui*."
        }
      ],
      "examples": [
        {
          "target": "Matau akimis.",
          "gloss": "I see with my eyes."
        },
        {
          "target": "Naktį sninga.",
          "gloss": "It snows at night.",
          "note": "accusative of time from naktis"
        },
        {
          "target": "Man skauda dantį.",
          "gloss": "My tooth hurts."
        }
      ],
