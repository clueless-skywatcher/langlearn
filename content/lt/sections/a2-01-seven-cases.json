{
  "id": "a2-01",
  "kind": "lesson",
  "level": "A2",
  "order": 1,
  "title": "The Seven Cases in Full",
  "summary": "The five declensions completed: every case in singular and plural, including the third and fifth paradigms that A1 only gestured at, and a review of what each case is for.",
  "rules": [
    {
      "id": "five-declensions",
      "number": "146",
      "heading": "The Five Declensions",
      "statement": "Lithuanian nouns fall into **five declensions**, sorted by the nominative singular ending and by the genitive that goes with it. A1 taught endings case by case; A2 puts the whole word in one table. The first two declensions cover most of the vocabulary already met; the third (*akis*), the fourth (*sūnus*), and the fifth (*vanduo, sesuo*) complete what was only sampled.",
      "paradigms": [
        {
          "caption": "How the declensions are told apart",
          "columns": [
            "declension",
            "nominative",
            "genitive sg.",
            "chiefly"
          ],
          "rows": [
            {
              "label": "I",
              "cells": [
                "-as, -is, -ys",
                "-o, -io",
                "masculine: namas, brolis, obuolys"
              ]
            },
            {
              "label": "II",
              "cells": [
                "-a, -ė",
                "-os, -ės",
                "feminine: knyga, katė (some masc. dėdė)"
              ]
            },
            {
              "label": "III",
              "cells": [
                "-is",
                "-ies / -ers",
                "mostly feminine: akis, moteris; some masc. dantis"
              ]
            },
            {
              "label": "IV",
              "cells": [
                "-us",
                "-aus",
                "masculine: sūnus, medus"
              ]
            },
            {
              "label": "V",
              "cells": [
                "-uo / duktė",
                "-ens / -ers",
                "vanduo, akmuo, sesuo, duktė"
              ]
            }
          ],
          "footnote": "The genitive is the citation form that settles the class: *akis, akies* is III; *brolis, brolio* is I, though both end in *-is* in the nominative."
        }
      ],
      "examples": [
        {
          "target": "brolis, brolio — I",
          "gloss": "brother (genitive -io)"
        },
        {
          "target": "akis, akies — III",
          "gloss": "eye (genitive -ies)"
        },
        {
          "target": "vanduo, vandens — V",
          "gloss": "water (genitive -ens)"
        }
      ],
      "seeAlso": [
        "noun-endings",
        "noun-gender",
        "genitive-endings"
      ],
      "core": true,
      "footnotes": []
    },
    {
      "id": "first-declension-paradigm",
      "number": "147",
      "heading": "The First Declension in Full",
      "statement": "Masculines in **-as, -is, -ys** form one class. The soft stems (*brolis, obuolys*) insert **i** before most endings; the locative singular of *-is/-ys* is **-yje**, not *-e*. The vocative of a common noun in *-as* is **-e**; personal names take **-ai** (¶78).",
      "paradigms": [
        {
          "caption": "namas, brolis — singular and plural",
          "columns": [
            "case",
            "namas sg.",
            "namas pl.",
            "brolis sg.",
            "brolis pl."
          ],
          "rows": [
            {
              "label": "nom.",
