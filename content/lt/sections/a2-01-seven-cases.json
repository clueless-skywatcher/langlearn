    {
      "id": "fifth-declension-paradigm",
      "number": "151",
      "heading": "The Fifth Declension: -uo and Kin",
      "statement": "The fifth class holds the **-uo** nouns (*vanduo, akmuo, šuo*) and the kinship pair *sesuo, duktė*. The stem lengthens by **-en-** or **-er-** outside the nominative singular: *vanduo → vandens → vandenį*. Learn the genitive with the word; from it the rest follows the soft pattern of III.",
      "paradigms": [
        {
          "caption": "vanduo, sesuo",
          "columns": [
            "case",
            "vanduo sg.",
            "vanduo pl.",
            "sesuo sg.",
            "sesuo pl."
