                "vandenys",
                "sesuo",
                "seserys"
              ]
            },
            {
              "label": "gen.",
              "cells": [
                "vandens",
                "vandenų",
                "sesers",
                "seserų"
              ]
            },
            {
              "label": "dat.",
              "cells": [
                "vandeniui",
                "vandenims",
                "seseriai",
                "seserims"
              ]
            },
            {
              "label": "acc.",
              "cells": [
                "vandenį",
                "vandenis",
                "seserį",
                "seseris"
              ]
            },
            {
              "label": "instr.",
              "cells": [
                "vandeniu",
                "vandenimis",
                "seserimi",
                "seserimis"
              ]
            },
            {
              "label": "loc.",
              "cells": [
                "vandenyje",
                "vandenyse",
                "seseryje",
                "seseryse"
              ]
            },
            {
              "label": "voc.",
              "cells": [
                "vandenie",
                "vandenys",
                "seserie",
                "seserys"
              ]
            }
          ],
          "footnote": "*duktė* declines like *sesuo* (*dukters, dukteriai, dukterį…*). *akmuo → akmens*; *šuo → šuns* (short genitive)."
        }
      ],
      "examples": [
