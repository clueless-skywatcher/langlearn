    {
      "id": "second-declension-paradigm",
      "number": "148",
      "heading": "The Second Declension in Full",
      "statement": "Feminines in **-a** and **-ė** (and a few masculines like *dėdė*) make the second class. Watch the instrumental singular of *-a*: it is spelled like the nominative (**knyga**), and only the sentence chooses. Softening before the genitive plural is regular: *katė → kačių*.",
      "paradigms": [
        {
          "caption": "knyga, katė — singular and plural",
          "columns": [
            "case",
            "knyga sg.",
            "knyga pl.",
            "katė sg.",
            "katė pl."
          ],
          "rows": [
            {
              "label": "nom.",
              "cells": [
                "knyga",
                "knygos",
                "katė",
                "katės"
              ]
            },
            {
              "label": "gen.",
              "cells": [
                "knygos",
                "knygų",
                "katės",
                "kačių"
              ]
            },
            {
              "label": "dat.",
              "cells": [
                "knygai",
                "knygoms",
                "katei",
                "katėms"
              ]
            },
            {
              "label": "acc.",
              "cells": [
                "knygą",
                "knygas",
                "katę",
                "kates"
              ]
            },
            {
              "label": "instr.",
              "cells": [
                "knyga",
                "knygomis",
                "kate",
                "katėmis"
              ]
            },
            {
              "label": "loc.",
              "cells": [
                "knygoje",
                "knygose",
                "katėje",
                "katėse"
              ]
            },
            {
              "label": "voc.",
              "cells": [
                "knyga",
                "knygos",
                "kate",
                "katės"
              ]
            }
          ],
          "footnote": "*knygos* is at once genitive singular and nominative plural; *knyga* is nominative, instrumental, and vocative singular. Homography is settled by syntax, never by the spelling alone."
        }
      ],
      "examples": [
