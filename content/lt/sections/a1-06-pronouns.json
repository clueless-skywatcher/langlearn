{
  "id": "a1-06",
  "kind": "lesson",
  "level": "A1",
  "order": 7,
  "title": "Pronouns",
  "summary": "The personal pronouns in every case met so far; the possessives, which do not decline at all; the reflexive *savo* and the ambiguity it exists to prevent; and the polite *jūs*.",
  "rules": [
    {
      "id": "pronouns-cases",
      "number": "42",
      "heading": "The Personal Pronouns Declined",
      "statement": "The personal pronouns have their own forms, which must be learned as a list — they follow none of the noun declensions. Three cases have now been met: the nominative for the subject (¶14), the accusative for the object (¶22), and the genitive. Observe that the third person has **one genitive for each gender**, and that *jų* serves both genders in the plural.",
      "paradigms": [
        {
          "caption": "Personal pronouns: nominative, accusative, genitive",
          "columns": [
            "nominative",
            "accusative",
            "genitive",
            "English"
          ],
          "rows": [
            {
              "label": "1 sg.",
              "cells": [
                "aš",
                "mane",
                "manęs",
                "I, me"
              ]
            },
            {
              "label": "2 sg.",
              "cells": [
                "tu",
                "tave",
                "tavęs",
                "you"
              ]
            },
            {
              "label": "3 sg. m.",
              "cells": [
                "jis",
                "jį",
                "jo",
                "he, him"
              ]
            },
            {
              "label": "3 sg. f.",
              "cells": [
                "ji",
                "ją",
                "jos",
                "she, her"
              ]
            },
            {
              "label": "1 pl.",
              "cells": [
                "mes",
                "mus",
                "mūsų",
                "we, us"
              ]
            },
            {
              "label": "2 pl.",
              "cells": [
                "jūs",
                "jus",
                "jūsų",
                "you"
              ]
            },
            {
              "label": "3 pl. m.",
              "cells": [
                "jie",
                "juos",
                "jų",
                "they, them"
              ]
            },
            {
              "label": "3 pl. f.",
              "cells": [
                "jos",
                "jas",
                "jų",
                "they, them"
              ]
            }
          ],
          "footnote": "*jie* is used of a mixed company; *jos* only where every member is feminine."
        }
      ],
      "examples": [
        {
          "target": "Jis mane mato.",
          "gloss": "He sees me."
        },
        {
          "target": "Mes jų nematome.",
          "gloss": "We do not see them.",
          "note": "genitive after a negated verb"
        },
        {
          "target": "Ar tu jį pažįsti?",
          "gloss": "Do you know him?"
        }
      ],
      "seeAlso": [
        "pronouns-nom",
        "accusative-pronouns",
        "genitive-negation"
      ],
      "core": true
    },
    {
      "id": "possessives",
      "number": "43",
      "heading": "The Possessive Pronouns",
      "statement": "The possessives are **mano, tavo, jo, jos, mūsų, jūsų, jų**. They are **indeclinable**: they take no ending for gender, number or case, and stand unchanged before the noun however that noun is declined. This is one of the few places where Lithuanian asks nothing of the learner. Note that in the third person and in the plural the possessive is simply the genitive of ¶42 — *jo namas* is literally \"of-him house\".",
      "paradigms": [
        {
          "caption": "The possessives before a noun in three cases",
          "columns": [
            "nominative",
            "accusative",
            "genitive"
          ],
          "rows": [
            {
              "label": "my",
              "cells": [
                "mano namas",
                "mano namą",
                "mano namo"
              ]
            },
            {
              "label": "your (sg.)",
              "cells": [
                "tavo katė",
                "tavo katę",
                "tavo katės"
              ]
            },
            {
              "label": "his",
              "cells": [
                "jo brolis",
                "jo brolį",
                "jo brolio"
              ]
            },
            {
              "label": "our",
              "cells": [
                "mūsų knyga",
                "mūsų knygą",
                "mūsų knygos"
              ]
            }
          ],
          "footnote": "The possessive never changes; only the noun does."
        }
      ],
      "examples": [
        {
          "target": "Tai mano brolis.",
          "gloss": "This is my brother."
        },
        {
          "target": "Aš matau tavo katę.",
          "gloss": "I see your cat."
        },
        {
          "target": "Mūsų mokytoja yra gera.",
          "gloss": "Our teacher is good."
        }
      ],
      "seeAlso": [
        "pronouns-cases",
        "genitive-possession"
      ],
      "core": true
    },
    {
      "id": "savo",
      "number": "44",
      "heading": "The Reflexive Possessive Savo",
      "statement": "When the possessor is **the subject of the same sentence**, Lithuanian requires **savo** in place of *jo, jos, jų*. The distinction is not a nicety: *jo* refers to somebody other than the subject, and using it where *savo* is meant says something different. English, having no such word, is ambiguous here and Lithuanian is not.",
      "examples": [
        {
          "target": "Jis myli savo brolį.",
          "gloss": "He loves his (own) brother."
        },
        {
          "target": "Jis myli jo brolį.",
          "gloss": "He loves his (another man's) brother.",
          "note": "a different man's brother — the only reading"
        },
        {
          "target": "Aš skaitau savo knygą.",
          "gloss": "I am reading my own book.",
          "note": "savo may replace mano and tavo too, where the possessor is the subject"
        }
      ],
      "footnotes": [
        "In the first and second persons *savo* is preferred but *mano* and *tavo* are not wrong, because no ambiguity is possible: *aš* can only be *aš*. In the third person *savo* is obligatory."
      ],
      "seeAlso": [
        "possessives"
      ],
      "core": true
    },
    {
      "id": "polite-jus",
      "number": "45",
      "heading": "Jūs as the Polite Form",
      "statement": "**Jūs** is both the plural \"you\" and the polite singular, used to one person who is a stranger, an elder, or a superior. The verb stands in the plural with it even when one person is meant. In letters it is written with a capital, *Jūs*. Using *tu* to a stranger is a real discourtesy, and the change to *tu* is something Lithuanians propose explicitly.",
      "examples": [
        {
          "target": "Ar Jūs kalbate lietuviškai?",
          "gloss": "Do you speak Lithuanian?",
          "note": "to one person, politely"
        },
        {
          "target": "Ar tu kalbi lietuviškai?",
          "gloss": "Do you speak Lithuanian?",
          "note": "to a friend or a child"
        },
        {
          "target": "Kaip Jūsų vardas?",
          "gloss": "What is your name?"
        }
      ],
      "seeAlso": [
        "pronouns-cases",
        "possessives"
      ],
      "core": true
    },
    {
      "id": "pronoun-omission",
      "number": "46",
      "heading": "When the Pronoun May Be Left Out",
      "statement": "Because the personal ending names the person (¶24), the subject pronoun is normally **omitted** unless it is emphatic or needed to prevent confusion. Two places require it: the second conjugation, where *tu* and *jis* share the form *-i* (¶36), and the third person of every conjugation, where one form serves both numbers and both genders.",
      "examples": [
        {
          "target": "Dirbu Vilniuje.",
          "gloss": "I work in Vilnius.",
          "note": "the -u says 'I' already"
        },
        {
          "target": "Aš dirbu, o ji nedirba.",
          "gloss": "I work, but she does not.",
          "note": "pronouns kept because the two are contrasted"
        },
        {
          "target": "Tu turi brolį.",
          "gloss": "You have a brother.",
          "note": "turi alone would be ambiguous"
        }
      ],
      "seeAlso": [
        "pronouns-cases",
        "present-conj-ii"
      ],
      "core": true
    },
    {
      "id": "tai-naming",
      "number": "47",
      "heading": "Tai in Naming and Introducing",
      "statement": "**Tai** — this is, that is — introduces or identifies, and does not change for the gender or number of what follows. It is the word with which people and things are presented, and *yra* may be left out after it.",
      "examples": [
        {
          "target": "Tai mano sesuo.",
          "gloss": "This is my sister."
        },
        {
          "target": "Tai yra mūsų namas.",
          "gloss": "This is our house."
        },
        {
          "target": "Tai Jonas ir Rūta.",
          "gloss": "This is Jonas and Rūta.",
          "note": "unchanged before a plural"
        }
      ],
      "seeAlso": [
        "possessives",
        "predicate-nominative"
      ],
      "core": false
    }
  ],
